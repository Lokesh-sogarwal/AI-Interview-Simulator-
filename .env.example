# Copy to .env.local and fill in real values. Never commit real secrets.
# None of these may be prefixed NEXT_PUBLIC_ unless noted (those are sent to the browser).

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
# Use a database dedicated to this app (it creates indexes, e.g. a unique index on users.email).
MONGODB_DB=interview_simulator

# Auth (long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_to_a_long_random_string

# Base URL used in email verification links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Privileged account bootstrap (server-only). Run `npm run provision:admins` once.
# Passwords: at least 12 characters, unique, never reused. Existing accounts are never modified.
SUPERADMIN_NAME=Platform Super Administrator
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# AI providers (tried in this order when configured). Without one, AI features return a clear
# "unavailable" error (no invented scores).
# OpenRouter: free ":free" models, key from https://openrouter.ai/keys (rate-limited; no card needed).
OPENROUTER_API_KEY=
# Optional: up to 3 comma-separated models; the rest act as automatic fallbacks.
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# Hugging Face (used when OpenRouter is not set or fails). Uses https://router.huggingface.co via the SDK.
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HUGGINGFACE_PROVIDER=
HUGGINGFACE_MODEL_RESUME=
HUGGINGFACE_MODEL_QUESTION=
HUGGINGFACE_MODEL_EVAL=
HUGGINGFACE_MODEL_CONVERSATION=

# OpenAI (fallback when Hugging Face is not set or fails)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Coding challenges: external sandbox (user code never runs on this server).
# Free demo option, no key: https://wandbox.org/api/compile.json (code is sent to wandbox.org).
# Production: self-hosted Piston, e.g. http://localhost:2000/api/v2/execute
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=

# Optional: allow saving interviews without signing in (defaults to off in production)
ALLOW_ANON_INTERVIEWS=false
